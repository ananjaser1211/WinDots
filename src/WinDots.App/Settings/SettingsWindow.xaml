<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDots.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="WinDots settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            AutomationProperties.Name="Settings sections"
            SelectionChanged="OnSectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Drawer" Tag="Drawer" IsSelected="True" />
                <muxc:NavigationViewItem Content="Media" Tag="Media" />
                <muxc:NavigationViewItem Content="Sources" Tag="Sources" />
                <muxc:NavigationViewItem Content="Lyrics" Tag="Lyrics" />
                <muxc:NavigationViewItem Content="Last.fm" Tag="LastFm" />
                <muxc:NavigationViewItem Content="Appearance" Tag="Appearance" />
                <muxc:NavigationViewItem Content="Visualiser" Tag="Visualiser" />
                <muxc:NavigationViewItem Content="Monitors" Tag="Monitors" />
                <muxc:NavigationViewItem Content="Privacy" Tag="Privacy" />
                <muxc:NavigationViewItem Content="Diagnostics" Tag="Diagnostics" />
                <muxc:NavigationViewItem Content="Startup" Tag="Startup" />
            </muxc:NavigationView.MenuItems>

            <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Drawer -->
                    <StackPanel x:Name="DrawerSection" Spacing="16">
                        <TextBlock Text="Drawer" Style="{StaticResource TitleTextBlockStyle}" />
                        <ToggleSwitch x:Name="DrawerEnabled" Header="Enabled" AutomationProperties.Name="Drawer enabled" />
                        <ToggleSwitch x:Name="ShowOnHover" Header="Show on hover" AutomationProperties.Name="Show on hover" />
                        <muxc:NumberBox x:Name="DragThreshold" Header="Drag threshold (px)" SpinButtonPlacementMode="Inline" Minimum="0" Maximum="1000" AutomationProperties.Name="Drag threshold in pixels" />
                        <StackPanel Spacing="4">
                            <TextBox x:Name="ToggleShortcut" Header="Toggle shortcut" PlaceholderText="Win+Shift+M" TextChanged="OnShortcutChanged" AutomationProperties.Name="Toggle shortcut" />
                            <TextBlock x:Name="ShortcutError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                            <StackPanel x:Name="ShortcutConflictPanel" Spacing="8" Visibility="Collapsed"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" FontSize="16" />
                                    <TextBlock x:Name="ShortcutConflictText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                               Text="This shortcut is already in use by another app, so WinDots could not register it." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SuggestShortcut" Content="Suggest alternative" Click="OnSuggestShortcut" AutomationProperties.Name="Suggest an alternative shortcut" />
                                    <Button x:Name="OpenKeyboardSettings" Content="Open Windows keyboard settings" Click="OnOpenKeyboardSettings" AutomationProperties.Name="Open Windows keyboard settings" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <muxc:NumberBox x:Name="AutoHideMs" Header="Auto-hide after inactivity (ms, 0 = never)" SpinButtonPlacementMode="Inline" Minimum="0" Maximum="600000" AutomationProperties.Name="Auto-hide milliseconds" />
                        <ToggleSwitch x:Name="HideAfterCommand" Header="Hide after a command" AutomationProperties.Name="Hide after command" />
                        <ToggleSwitch x:Name="HideInFullscreen" Header="Hide while a fullscreen app is active" AutomationProperties.Name="Hide in fullscreen" />
                        <ToggleSwitch x:Name="AlwaysOnTop" Header="Always on top while open" AutomationProperties.Name="Always on top" />
                    </StackPanel>

                    <!-- Media -->
                    <StackPanel x:Name="MediaSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Media" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBox x:Name="PreferredPlayer" Header="Preferred player (AUMID or exe name)" AutomationProperties.Name="Preferred player" />
                        <StackPanel Spacing="4">
                            <TextBox x:Name="IgnoredPlayers" Header="Ignored players (one per line)" AcceptsReturn="True" TextWrapping="Wrap" Height="96" AutomationProperties.Name="Ignored players" />
                            <TextBlock Text="Sessions from these players are never shown." Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBox x:Name="PlayerAliases" Header="Player aliases (one key=value per line)" AcceptsReturn="True" TextWrapping="Wrap" Height="96" AutomationProperties.Name="Player aliases" />
                            <TextBlock Text="Example: Spotify.exe=Spotify" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <muxc:NumberBox x:Name="TimelineTick" Header="Timeline tick (ms)" SpinButtonPlacementMode="Inline" Minimum="50" Maximum="5000" AutomationProperties.Name="Timeline tick milliseconds" />
                        <ComboBox x:Name="SourceMode" Header="Show sources" AutomationProperties.Name="Source mode">
                            <ComboBoxItem Content="Tracked (music only)" />
                            <ComboBoxItem Content="All sources" />
                        </ComboBox>
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="CaptureMediaKeys" Header="Capture media keys" AutomationProperties.Name="Capture media keys" />
                            <TextBlock Text="Route Play/Pause, Next, Previous, and Stop to the active music session. This overrides Windows' system routing." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sources -->
                    <StackPanel x:Name="SourcesSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Sources" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Every media source WinDots has seen. Set each to Always show, Auto (let the detector decide), or Never." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="SourcesList" Spacing="12" />
                        <TextBlock x:Name="SourcesEmpty" Text="No sources seen yet. Play something and reopen settings." Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Lyrics -->
                    <StackPanel x:Name="LyricsSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Lyrics" Style="{StaticResource TitleTextBlockStyle}" />
                        <ComboBox x:Name="LyricsProviderBox" Header="Lyrics provider" AutomationProperties.Name="Lyrics provider">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="LRCLIB" />
                        </ComboBox>
                        <TextBlock
                            Text="When set to LRCLIB, WinDots sends the current track's title, artist, album, and duration to lrclib.net over HTTPS to fetch lyrics. Nothing is sent while lyrics are Off."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <muxc:NumberBox x:Name="LyricsOffset" Header="Default sync offset (ms)" SpinButtonPlacementMode="Inline" SmallChange="100" Minimum="-10000" Maximum="10000" AutomationProperties.Name="Default lyrics offset milliseconds" />
                    </StackPanel>

                    <!-- Last.fm -->
                    <StackPanel x:Name="LastFmSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Last.fm" Style="{StaticResource TitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="LastFmEnabled" Header="Enabled" AutomationProperties.Name="Last.fm enabled" />
                            <TextBlock Text="When enabled and signed in, WinDots sends the current track's artist, title, album, and duration to Last.fm for now-playing and scrobbles. Nothing is sent while off or signed out." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LastFmScrobble" Header="Scrobble played tracks" AutomationProperties.Name="Scrobble played tracks" />
                        <ToggleSwitch x:Name="LastFmNowPlaying" Header="Send now-playing" AutomationProperties.Name="Send now playing" />

                        <!-- Create a key (shown only when the build has no embedded key and none is stored) -->
                        <StackPanel x:Name="LastFmKeyPanel" Spacing="8" Visibility="Collapsed" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                            <TextBlock Text="This build has no Last.fm application key. Create one, then paste the key and secret here." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <Button x:Name="LastFmCreateKey" Content="Create a key" Click="OnLastFmCreateKey" AutomationProperties.Name="Create a Last.fm API key" />
                            <TextBox x:Name="LastFmApiKey" Header="API key" AutomationProperties.Name="Last.fm API key" />
                            <PasswordBox x:Name="LastFmApiSecret" Header="Shared secret" AutomationProperties.Name="Last.fm shared secret" />
                            <Button x:Name="LastFmValidate" Content="Validate and save key" Click="OnLastFmValidateKey" AutomationProperties.Name="Validate and save key" />
                        </StackPanel>

                        <!-- Signed-out (key present) -->
                        <StackPanel x:Name="LastFmSignInPanel" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="LastFmSignIn" Content="Sign in with Last.fm" Style="{StaticResource AccentButtonStyle}" Click="OnLastFmSignIn" AutomationProperties.Name="Sign in with Last.fm" />
                            <StackPanel x:Name="LastFmSignInProgress" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <muxc:ProgressRing IsActive="True" Width="20" Height="20" />
                                <TextBlock Text="Waiting for you to authorise WinDots in the browser…" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button x:Name="LastFmCancelSignIn" Content="Cancel" Click="OnLastFmCancelSignIn" AutomationProperties.Name="Cancel sign in" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Signed-in -->
                        <StackPanel x:Name="LastFmSignedInPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <muxc:PersonPicture x:Name="LastFmAvatar" Width="48" Height="48" AutomationProperties.Name="Last.fm avatar" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LastFmUserName" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Signed in" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="LastFmSignOut" Content="Sign out" Click="OnLastFmSignOut" AutomationProperties.Name="Sign out of Last.fm" />
                            <TextBlock Text="Recent scrobbles" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel x:Name="LastFmRecent" Spacing="6" />
                            <TextBlock x:Name="LastFmRecentEmpty" Text="No recent tracks." Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock x:Name="LastFmStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="AppearanceSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" />
                        <ComboBox x:Name="Theme" Header="Theme" AutomationProperties.Name="Theme">
                            <ComboBoxItem Content="Auto" />
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                        </ComboBox>
                        <ComboBox x:Name="Backdrop" Header="Backdrop" AutomationProperties.Name="Backdrop">
                            <ComboBoxItem Content="Acrylic" />
                            <ComboBoxItem Content="Opaque" />
                        </ComboBox>
                        <muxc:NumberBox x:Name="FontScale" Header="Font scale" SpinButtonPlacementMode="Inline" SmallChange="0.05" Minimum="0.5" Maximum="3" AutomationProperties.Name="Font scale" />
                        <muxc:NumberBox x:Name="BlobDeform" Header="Blob deform" SpinButtonPlacementMode="Inline" SmallChange="0.05" Minimum="0" Maximum="3" AutomationProperties.Name="Blob deform" />
                        <ComboBox x:Name="PaletteSource" Header="Palette source" AutomationProperties.Name="Palette source">
                            <ComboBoxItem Content="Artwork" />
                            <ComboBoxItem Content="Fixed" />
                        </ComboBox>
                        <TextBox x:Name="FixedAccent" Header="Fixed accent (hex, e.g. #8FD3C8)" AutomationProperties.Name="Fixed accent colour" />
                        <ComboBox x:Name="ReduceMotion" Header="Reduce motion" AutomationProperties.Name="Reduce motion">
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="On" />
                            <ComboBoxItem Content="Off" />
                        </ComboBox>
                        <ToggleSwitch x:Name="BackgroundBlobs" Header="Background blobs" AutomationProperties.Name="Background blobs" />
                    </StackPanel>

                    <!-- Visualiser -->
                    <StackPanel x:Name="VisualiserSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Visualiser" Style="{StaticResource TitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="VisualiserEnabled" Header="Enabled" AutomationProperties.Name="Visualiser enabled" />
                            <TextBlock Text="Renders the system audio output around the media drawer. It is analysed in memory only and never stored or sent. Off automatically under reduced motion, battery saver, or a remote session." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="VisualiserStyleBox" Header="Style" AutomationProperties.Name="Visualiser style">
                            <ComboBoxItem Content="Bars" />
                            <ComboBoxItem Content="Waveform" />
                            <ComboBoxItem Content="Ring (around the artwork)" />
                            <ComboBoxItem Content="Halo" />
                            <ComboBoxItem Content="Blob pulse" />
                            <ComboBoxItem Content="Particles" />
                        </ComboBox>
                        <ComboBox x:Name="VisualiserPlacementBox" Header="Placement" AutomationProperties.Name="Visualiser placement">
                            <ComboBoxItem Content="Under artwork" />
                            <ComboBoxItem Content="Over artwork" />
                            <ComboBoxItem Content="Behind artwork" />
                            <ComboBoxItem Content="Bottom strip" />
                        </ComboBox>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Bars" Style="{StaticResource BodyTextBlockStyle}" />
                            <Slider x:Name="VisualiserBars" Minimum="24" Maximum="96" StepFrequency="1" AutomationProperties.Name="Visualiser bar count" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Smoothing" Style="{StaticResource BodyTextBlockStyle}" />
                            <Slider x:Name="VisualiserSmoothing" Minimum="0" Maximum="0.95" StepFrequency="0.05" AutomationProperties.Name="Visualiser smoothing" />
                        </StackPanel>
                        <ToggleSwitch x:Name="VisualiserMirrored" Header="Mirror bars about the centre" AutomationProperties.Name="Mirror visualiser bars" />
                    </StackPanel>

                    <!-- Monitors -->
                    <StackPanel x:Name="MonitorsSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Monitors" Style="{StaticResource TitleTextBlockStyle}" />
                        <ComboBox x:Name="MonitorMode" Header="Show handle on" SelectionChanged="OnMonitorModeChanged" AutomationProperties.Name="Monitor mode">
                            <ComboBoxItem Content="All monitors" />
                            <ComboBoxItem Content="Primary monitor" />
                            <ComboBoxItem Content="Selected monitors" />
                        </ComboBox>
                        <StackPanel x:Name="MonitorList" Spacing="8" />
                        <muxc:NumberBox x:Name="HandleOffset" Header="Handle horizontal position (%)" SpinButtonPlacementMode="Inline" Minimum="0" Maximum="100" AutomationProperties.Name="Handle offset percent" />
                    </StackPanel>

                    <!-- Privacy -->
                    <StackPanel x:Name="PrivacySection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Privacy" Style="{StaticResource TitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="HistoryEnabled" Header="Listening history" IsEnabled="False" AutomationProperties.Name="Listening history" />
                            <TextBlock Text="Coming later. History collection is not implemented yet." Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <muxc:NumberBox x:Name="HistoryRetention" Header="History retention (days)" SpinButtonPlacementMode="Inline" Minimum="0" Maximum="3650" AutomationProperties.Name="History retention days" />
                    </StackPanel>

                    <!-- Diagnostics -->
                    <StackPanel x:Name="DiagnosticsSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" />
                        <ComboBox x:Name="LogLevel" Header="Log level" AutomationProperties.Name="Log level">
                            <ComboBoxItem Content="Warning" />
                            <ComboBoxItem Content="Info" />
                            <ComboBoxItem Content="Debug" />
                        </ComboBox>
                        <ToggleSwitch x:Name="IncludeMediaText" Header="Include media text in logs" AutomationProperties.Name="Include media text" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open log folder" Click="OnOpenLogFolder" AutomationProperties.Name="Open log folder" />
                            <Button x:Name="ExportDiagnostics" Content="Export diagnostics" IsEnabled="False" AutomationProperties.Name="Export diagnostics" />
                        </StackPanel>
                        <TextBlock Text="Export is a placeholder until the packaging milestone." Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <!-- Startup -->
                    <StackPanel x:Name="StartupSection" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Startup" Style="{StaticResource TitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="StartWithWindows" Header="Start with Windows" Toggled="OnStartupToggled" AutomationProperties.Name="Start with Windows" />
                            <TextBlock x:Name="StartupNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </muxc:NavigationView>

        <Grid Grid.Row="1" Padding="24,12" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <Button x:Name="RevertButton" Grid.Column="1" Content="Revert" Click="OnRevert" AutomationProperties.Name="Revert changes" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" AutomationProperties.Name="Save settings" />
        </Grid>
    </Grid>
</Window>
