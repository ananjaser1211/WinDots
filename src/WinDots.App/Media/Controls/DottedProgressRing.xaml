<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDots.App.Media.Controls.DottedProgressRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- High-contrast dot colour: all dots render in WindowText when high contrast is active. -->
        <SolidColorBrush x:Key="WdHighContrastDotBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </UserControl.Resources>

    <Canvas x:Name="DotCanvas" />
</UserControl>
