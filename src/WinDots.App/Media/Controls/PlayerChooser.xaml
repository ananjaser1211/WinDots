<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDots.App.Media.Controls.PlayerChooser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <Button
        x:Name="ChooserButton"
        Padding="12,8"
        BorderThickness="0"
        HorizontalContentAlignment="Stretch"
        CornerRadius="{StaticResource RadiusPill}"
        Background="{ThemeResource WdSurfaceRaisedBrush}"
        automation:AutomationProperties.Name="Player">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="16" Foreground="{x:Bind AccentBrush, Mode=OneWay}" />
            <TextBlock
                x:Name="LabelText"
                Grid.Column="1"
                Text="Automatic"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                VerticalAlignment="Center"
                Style="{StaticResource WdBodyTextStyle}" />
            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource WdOnSurfaceMutedBrush}" />
        </Grid>
        <Button.Flyout>
            <MenuFlyout x:Name="Menu" Opening="OnMenuOpening" />
        </Button.Flyout>
    </Button>
</UserControl>
