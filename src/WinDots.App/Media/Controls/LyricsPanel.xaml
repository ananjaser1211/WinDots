<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDots.App.Media.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinDots.App.Media.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: lyrics glyph + label, and an overflow menu. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE8D2;" FontSize="18" Margin="0,0,8,0" Foreground="{ThemeResource WdOnSurfaceBrush}" />
            <TextBlock Grid.Column="1" Text="Lyrics" VerticalAlignment="Center" Style="{StaticResource WdSubtitleTextStyle}" />
            <Button
                Grid.Column="2"
                Width="36"
                Height="36"
                Padding="0"
                BorderThickness="0"
                CornerRadius="{StaticResource RadiusPill}"
                Background="{ThemeResource WdSurfaceRaisedBrush}"
                automation:AutomationProperties.Name="More"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
                <FontIcon Glyph="&#xE712;" FontSize="16" Foreground="{ThemeResource WdOnSurfaceBrush}" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="EnableLyricsItem" Text="Enable lyrics" Click="OnEnableLyricsClick" Visibility="Collapsed" />
                        <MenuFlyoutItem x:Name="OffsetPlusItem" Text="Lyrics offset +0.5 s" Click="OnOffsetPlusClick" />
                        <MenuFlyoutItem x:Name="OffsetMinusItem" Text="Lyrics offset -0.5 s" Click="OnOffsetMinusClick" />
                        <MenuFlyoutItem x:Name="OffsetResetItem" Text="Reset lyrics offset" Click="OnOffsetResetClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Copy track info" Click="OnCopyClick" />
                        <MenuFlyoutItem Text="Open in player" Click="OnOpenInPlayerClick" />
                        <MenuFlyoutItem Text="Why is volume hidden?" Click="OnWhyVolumeHiddenClick" />
                        <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Off prompt: shown when lyrics are turned off. -->
        <StackPanel
            x:Name="OffPrompt"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE8D2;" FontSize="36" HorizontalAlignment="Center" Foreground="{ThemeResource WdOnSurfaceMutedBrush}" />
            <TextBlock
                Text="Lyrics are off"
                HorizontalAlignment="Center"
                Style="{StaticResource WdBodyTextStyle}"
                Foreground="{ThemeResource WdOnSurfaceMutedBrush}" />
            <Button
                Content="Enable lyrics"
                HorizontalAlignment="Center"
                Click="OnEnableLyricsClick"
                automation:AutomationProperties.Name="Enable lyrics" />
        </StackPanel>

        <!-- Loading spinner. -->
        <StackPanel
            x:Name="LoadingPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="28" Height="28" automation:AutomationProperties.Name="Loading lyrics" />
            <TextBlock
                Text="Finding lyrics…"
                HorizontalAlignment="Center"
                Style="{StaticResource WdCaptionTextStyle}"
                Foreground="{ThemeResource WdOnSurfaceMutedBrush}" />
        </StackPanel>

        <!-- Placeholder: shown when a lookup finds no lyrics. -->
        <StackPanel
            x:Name="Placeholder"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE9BF;" FontSize="40" HorizontalAlignment="Center" Foreground="{ThemeResource WdOnSurfaceMutedBrush}" />
            <TextBlock
                Text="No lyrics found"
                HorizontalAlignment="Center"
                Style="{StaticResource WdBodyTextStyle}"
                Foreground="{ThemeResource WdOnSurfaceMutedBrush}" />
        </StackPanel>

        <!-- Lyrics body. -->
        <ScrollViewer x:Name="LyricsScroller" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LinesHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:LyricLineView">
                        <TextBlock
                            Text="{x:Bind Text}"
                            Margin="0,3"
                            TextWrapping="Wrap"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Opacity="{x:Bind Opacity, Mode=OneWay}"
                            Foreground="{x:Bind Foreground, Mode=OneWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Attribution caption. -->
        <TextBlock
            x:Name="Attribution"
            Grid.Row="2"
            Style="{StaticResource WdCaptionTextStyle}"
            Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
