<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDots.App.Media.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDots.App.Media.Controls"
    Background="{ThemeResource WdSurfaceBrush}"
    IsTabStop="False">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout" />
                <!-- At very large text scale / a narrow width there is no room for the lyrics column; collapse it so
                     the artwork and metadata keep their space (lyrics remain reachable once text scale is normal). -->
                <VisualState x:Name="StackedLayout">
                    <VisualState.Setters>
                        <Setter Target="LyricsColumn.Width" Value="0" />
                        <Setter Target="LyricsCell.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Background blobs: three large soft BlobTint shapes drifting behind the content (_docs/04-visual-design.md).
             Declared first so they render behind everything; IsHitTestVisible off so they never intercept input. -->
        <Canvas
            x:Name="BlobCanvas"
            Grid.Row="0"
            Grid.RowSpan="3"
            IsHitTestVisible="False">
            <Ellipse
                x:Name="Blob1"
                Width="260"
                Height="260"
                Opacity="0.5"
                Canvas.Left="-40"
                Canvas.Top="-70"
                Fill="{x:Bind ViewModel.BlobTintBrush}" />
            <Ellipse
                x:Name="Blob2"
                Width="200"
                Height="200"
                Opacity="0.5"
                Canvas.Left="520"
                Canvas.Top="150"
                Fill="{x:Bind ViewModel.BlobTintBrush}" />
            <Ellipse
                x:Name="Blob3"
                Width="180"
                Height="180"
                Opacity="0.5"
                Canvas.Left="300"
                Canvas.Top="-50"
                Fill="{x:Bind ViewModel.BlobTintBrush}" />
        </Canvas>

        <!-- Tab strip: a single "Media" tab (glyph + accent label + short accent underline). -->
        <Grid Grid.Row="0" Padding="24,6,24,4" HorizontalAlignment="Stretch">
            <Button
                x:Name="MediaTab"
                HorizontalAlignment="Center"
                Padding="12,2"
                BorderThickness="0"
                Background="Transparent"
                AutomationProperties.Name="Media tab">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="2">
                    <FontIcon
                        Glyph="&#xE8D6;"
                        FontSize="16"
                        HorizontalAlignment="Center"
                        Foreground="{x:Bind ViewModel.AccentBrush}" />
                    <TextBlock
                        Text="Media"
                        HorizontalAlignment="Center"
                        Style="{StaticResource WdCaptionTextStyle}"
                        Foreground="{x:Bind ViewModel.AccentBrush}" />
                    <Border
                        Width="28"
                        Height="2"
                        Margin="0,2,0,0"
                        CornerRadius="{StaticResource RadiusPill}"
                        Background="{x:Bind ViewModel.AccentBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Thin divider under the tab strip. -->
        <Border Grid.Row="1" Height="1" Background="{ThemeResource WdOutlineBrush}" />

        <!-- Body: three columns (artwork, metadata + transport, lyrics + chooser) in a single star-height row so the
             body exactly fills the drawer. The lyrics column is therefore height-bounded and its own list scrolls
             internally instead of growing the body and shifting the artwork/metadata. At >150% text scale or a narrow
             width the lyrics column collapses (LayoutStates, driven from EvaluateLayout). -->
        <Grid Grid.Row="2" x:Name="BodyGrid" Margin="20,10,20,14" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="LyricsColumn" Width="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Left: blob artwork wrapped by the dotted progress ring. -->
            <Grid x:Name="ArtworkCell" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:DottedProgressRing
                    x:Name="ProgressRing"
                    Canvas.ZIndex="0"
                    Size="200"
                    DotCount="72"
                    DotDiameter="3.5"
                    Progress="{x:Bind ViewModel.Progress, Mode=OneWay}"
                    AccentBrush="{x:Bind ViewModel.AccentBrush}"
                    TrackBrush="{ThemeResource WdRingTrackBrush}"
                    Visibility="{x:Bind RingVisible(ViewModel.IsEmpty, ViewModel.Duration, ViewModel.VisualiserActive, ViewModel.VisualiserStyle, ViewModel.VisualiserPlacement), Mode=OneWay}" />
                <controls:BlobArtwork
                    x:Name="Artwork"
                    Canvas.ZIndex="1"
                    Size="172"
                    ImageSource="{x:Bind ViewModel.Artwork, Mode=OneWay}" />
                <!-- Art-area visualiser (ring / halo / particles) at an art placement: overlaps the ring area around the
                     album blob. Placement drives the z-order (over / between / behind); Bottom moves it to the strip. -->
                <controls:Visualiser
                    x:Name="ArtVisualiser"
                    Width="204"
                    Height="204"
                    IsHitTestVisible="False"
                    Canvas.ZIndex="{x:Bind ArtVisualiserZ(ViewModel.VisualiserPlacement), Mode=OneWay}"
                    RenderStyle="{x:Bind ViewModel.VisualiserStyle, Mode=OneWay}"
                    AccentBrush="{x:Bind ViewModel.AccentBrush}"
                    BarCount="{x:Bind ViewModel.VisualiserBarCount, Mode=OneWay}"
                    Mirrored="{x:Bind ViewModel.VisualiserMirrored, Mode=OneWay}"
                    Bands="{x:Bind ViewModel.VisualiserBands, Mode=OneWay}"
                    Waveform="{x:Bind ViewModel.VisualiserWaveform, Mode=OneWay}"
                    Visibility="{x:Bind ArtVisualiserVisible(ViewModel.VisualiserActive, ViewModel.VisualiserStyle, ViewModel.VisualiserPlacement), Mode=OneWay}" />
            </Grid>

            <!-- Centre: metadata, seek, transport, status, volume placeholder. -->
            <StackPanel x:Name="MetadataPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        Style="{StaticResource WdTitleTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        AutomationProperties.Name="Title"
                        Visibility="{x:Bind Shown(ViewModel.IsEmpty), Mode=OneWay}" />
                    <ToggleButton
                        x:Name="LoveButton"
                        Grid.Column="1"
                        Padding="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="OnLoveClicked"
                        ToolTipService.ToolTip="Love on Last.fm"
                        AutomationProperties.Name="Love this track on Last.fm">
                        <FontIcon x:Name="LoveIcon" Glyph="&#xEB51;" FontSize="16" />
                    </ToggleButton>
                </Grid>
                <TextBlock
                    Text="{x:Bind ViewModel.ArtistText, Mode=OneWay}"
                    Style="{StaticResource WdSubtitleTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"
                    AutomationProperties.Name="Artist" />
                <TextBlock
                    Text="{x:Bind ViewModel.AlbumText, Mode=OneWay}"
                    Style="{StaticResource WdBodyTextStyle}"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1"
                    AutomationProperties.Name="Album" />

                <controls:SeekBar
                    x:Name="Seek"
                    Margin="0,6,0,0"
                    AccentBrush="{x:Bind ViewModel.AccentBrush}"
                    Position="{x:Bind ViewModel.Position, Mode=OneWay}"
                    Duration="{x:Bind ViewModel.Duration, Mode=OneWay}"
                    CanSeek="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                    SeekRequested="OnSeekRequested" />

                <controls:TransportBar
                    x:Name="Transport"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    AccentBrush="{x:Bind ViewModel.AccentBrush}"
                    OnAccentBrush="{x:Bind ViewModel.OnAccentBrush}"
                    Capabilities="{x:Bind ViewModel.Capabilities, Mode=OneWay}"
                    IsPlaying="{x:Bind ViewModel.IsPlaying, Mode=OneWay}"
                    IsShuffleOn="{x:Bind ViewModel.IsShuffleOn, Mode=OneWay}"
                    RepeatMode="{x:Bind ViewModel.RepeatMode, Mode=OneWay}"
                    ShuffleRequested="OnShuffleRequested"
                    PreviousRequested="OnPreviousRequested"
                    PlayPauseRequested="OnPlayPauseRequested"
                    NextRequested="OnNextRequested"
                    RepeatRequested="OnRepeatRequested" />

                <TextBlock
                    x:Name="StatusCaption"
                    Margin="0,6,0,0"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource WdCaptionTextStyle}"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Visibility="{x:Bind HasText(ViewModel.StatusText), Mode=OneWay}"
                    AutomationProperties.LiveSetting="Assertive" />

                <!-- Volume row (MediaPlayer.png): shown only when the audio session match is confident enough. -->
                <Grid
                    x:Name="VolumeRow"
                    Margin="0,4,0,0"
                    ColumnSpacing="8"
                    Visibility="{x:Bind Vis(ViewModel.VolumeAvailable), Mode=OneWay}"
                    PointerWheelChanged="OnVolumeWheel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="MuteButton"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnMuteClick"
                        AutomationProperties.Name="{x:Bind MuteName(ViewModel.IsMuted), Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind VolumeGlyph(ViewModel.IsMuted, ViewModel.VolumeLevel), Mode=OneWay}" FontSize="14" Foreground="{ThemeResource WdOnSurfaceBrush}" />
                    </Button>
                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        SmallChange="2"
                        StepFrequency="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource WdAccentSliderStyle}"
                        Foreground="{x:Bind ViewModel.AccentBrush}"
                        Value="{x:Bind ViewModel.VolumeLevel, Mode=OneWay}"
                        ValueChanged="OnVolumeSliderChanged"
                        AutomationProperties.Name="Volume" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            Text="{x:Bind Percent(ViewModel.VolumeLevel), Mode=OneWay}"
                            Style="{StaticResource WdCaptionTextStyle}"
                            Foreground="{ThemeResource WdOnSurfaceBrush}"
                            MinWidth="36"
                            TextAlignment="Right" />
                        <TextBlock
                            Text="shared"
                            Style="{StaticResource WdCaptionTextStyle}"
                            Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                            TextAlignment="Right"
                            Visibility="{x:Bind Vis(ViewModel.VolumeShared), Mode=OneWay}"
                            ToolTipService.ToolTip="This volume applies to every window of the player (for example all browser tabs)." />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Right: lyrics slot (row 0, star - bounded by the body height so it scrolls internally) with the player
                 chooser pinned to its bottom (row 1). -->
            <Grid x:Name="LyricsCell" Grid.Column="2" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:LyricsPanel
                    x:Name="Lyrics"
                    Grid.Row="0"
                    AccentBrush="{x:Bind ViewModel.AccentBrush}"
                    Lines="{x:Bind ViewModel.LyricsLines, Mode=OneWay}"
                    CurrentIndex="{x:Bind ViewModel.LyricsCurrentIndex, Mode=OneWay}"
                    Synced="{x:Bind ViewModel.LyricsSynced, Mode=OneWay}"
                    AttributionText="{x:Bind ViewModel.LyricsAttribution, Mode=OneWay}"
                    State="{x:Bind ViewModel.LyricsState, Mode=OneWay}"
                    EnableLyricsRequested="OnLyricsEnable"
                    OffsetIncreaseRequested="OnLyricsOffsetIncrease"
                    OffsetDecreaseRequested="OnLyricsOffsetDecrease"
                    OffsetResetRequested="OnLyricsOffsetReset"
                    CopyRequested="OnLyricsCopy"
                    OpenInPlayerRequested="OnLyricsOpen"
                    WhyVolumeHiddenRequested="OnLyricsWhyVolumeHidden"
                    SettingsRequested="OnLyricsSettings" />

                <controls:PlayerChooser
                    x:Name="Chooser"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    AccentBrush="{x:Bind ViewModel.AccentBrush}"
                    Items="{x:Bind ViewModel.ChooserItems, Mode=OneWay}"
                    ActiveLabel="{x:Bind ViewModel.ActiveChooserLabel, Mode=OneWay}"
                    ShowAllSources="{x:Bind ViewModel.ShowAllSources, Mode=TwoWay}"
                    PlayerSelected="OnPlayerSelected" />
            </Grid>
        </Grid>

        <!-- Strip visualiser (bars / waveform): a thin band pinned across the bottom of the drawer body. -->
        <controls:Visualiser
            x:Name="StripVisualiser"
            Grid.Row="2"
            Height="56"
            Margin="20,0,20,6"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            RenderStyle="{x:Bind ViewModel.VisualiserStyle, Mode=OneWay}"
            AccentBrush="{x:Bind ViewModel.AccentBrush}"
            BarCount="{x:Bind ViewModel.VisualiserBarCount, Mode=OneWay}"
            Mirrored="{x:Bind ViewModel.VisualiserMirrored, Mode=OneWay}"
            Bands="{x:Bind ViewModel.VisualiserBands, Mode=OneWay}"
            Waveform="{x:Bind ViewModel.VisualiserWaveform, Mode=OneWay}"
            Visibility="{x:Bind StripVisualiserVisible(ViewModel.VisualiserActive, ViewModel.VisualiserStyle, ViewModel.VisualiserPlacement), Mode=OneWay}" />

        <!-- Hidden live region: announces play/pause transitions to Narrator without occupying layout. Its text is set
             from code-behind on IsPlaying changes; Opacity 0 keeps it invisible while still exposed to UI Automation. -->
        <TextBlock
            x:Name="PlayStateAnnouncer"
            Grid.Row="0"
            Opacity="0"
            IsHitTestVisible="False"
            Text=""
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Playback state" />
    </Grid>
</UserControl>
