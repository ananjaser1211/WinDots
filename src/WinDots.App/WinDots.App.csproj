<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinDots.App</RootNamespace>
    <AssemblyName>WinDots</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <ApplicationIcon />
    <Nullable>enable</Nullable>
    <!-- XAML-generated code is not under our style control. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Provider app keys are build-time secrets, never committed. The release machine sets the WinDotsLastFmApiKey and
    WinDotsLastFmSecret environment variables (MSBuild imports them as properties); they are embedded as assembly
    metadata and read at runtime by LastFmKeys. When unset the values are empty and the app shows the "Create a key"
    helper. See _docs/09-dev-environment.md and _docs/10-enhancement-plan.md (E4).
  -->
  <ItemGroup>
    <AssemblyMetadata Include="WinDotsLastFmApiKey" Value="$(WinDotsLastFmApiKey)" />
    <AssemblyMetadata Include="WinDotsLastFmSecret" Value="$(WinDotsLastFmSecret)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDots.Core\WinDots.Core.csproj" />
    <ProjectReference Include="..\WinDots.Windows\WinDots.Windows.csproj" />
  </ItemGroup>

</Project>
