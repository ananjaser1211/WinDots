<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDots.App.Shell.DrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:WinDots.App.Media"
    xmlns:dashboard="using:WinDots.App.Dashboard"
    xmlns:controls="using:WinDots.App.Shell.Controls"
    xmlns:pages="using:WinDots.App.Shell.Pages">

    <!-- The window is resized from the top edge to reveal the drawer; Root keeps its full design height (tab strip +
         active page) and is translated so its bottom edge stays on the window's bottom edge. The tab strip sits at the
         top and also carries the upward drag-to-close gesture (handled in code with a movement threshold so tab clicks
         still register). Only the selected tab's page is visible. -->
    <Grid x:Name="RootHost" Background="{ThemeResource WdSurfaceBrush}" VerticalAlignment="Top">
        <Border
            x:Name="Root"
            VerticalAlignment="Top"
            Background="{ThemeResource WdSurfaceBrush}"
            BorderBrush="{ThemeResource WdOutlineBrush}"
            BorderThickness="1"
            CornerRadius="0,0,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:DrawerTabStrip x:Name="TabStrip" Grid.Row="0" />

                <Grid x:Name="PageHost" Grid.Row="1">
                    <media:MediaPage x:Name="Page" />
                    <dashboard:DashboardPage x:Name="DashPage" Visibility="Collapsed" />
                    <pages:PerformancePage x:Name="PerfPage" Visibility="Collapsed" />
                    <pages:WeatherPage x:Name="WeatherPageView" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
