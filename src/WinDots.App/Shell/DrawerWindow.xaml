<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDots.App.Shell.DrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:WinDots.App.Media">

    <!-- The window is resized from the top edge to reveal the drawer; Root keeps its full design height and is
         translated so its bottom edge stays on the window's bottom edge. -->
    <Grid x:Name="RootHost" Background="{ThemeResource WdSurfaceBrush}" VerticalAlignment="Top">
        <Border
            x:Name="Root"
            VerticalAlignment="Top"
            Background="{ThemeResource WdSurfaceBrush}"
            BorderBrush="{ThemeResource WdOutlineBrush}"
            BorderThickness="1"
            CornerRadius="0,0,24,24">
            <Grid>
                <media:MediaPage x:Name="Page" />

                <!-- Top 24px band accepts upward drags to close; transparent so the tab strip shows through. -->
                <Border
                    x:Name="DragBand"
                    Height="24"
                    Background="Transparent"
                    VerticalAlignment="Top" />
            </Grid>
        </Border>
    </Grid>
</Window>
