<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDots.App.Shell.Pages.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    IsTabStop="False">

    <!-- Placeholder: the Performance tab (detailed graphs) lands in a later milestone. -->
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="{StaticResource Space2}">
        <FontIcon
            HorizontalAlignment="Center"
            FontFamily="Segoe Fluent Icons"
            FontSize="28"
            Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
            Glyph="&#xE9D9;" />
        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
            Style="{StaticResource WdBodyTextStyle}"
            Text="Performance — coming soon" />
    </StackPanel>
</UserControl>
