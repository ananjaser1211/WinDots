<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinDots.App.Shell.Controls.DrawerTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- Each tab is a bare button: transparent by default, a low-opacity On-Surface scrim on hover/press, and the
             system focus rectangle for keyboard focus. Selection styling (accent icon/label + underline) is applied in
             code so it stays theme-aware (ClearValue restores the muted ThemeResource default). -->
        <Style x:Key="WdTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="{StaticResource Space3}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMedium}">
                            <Border
                                x:Name="Scrim"
                                Background="{ThemeResource WdOnSurfaceBrush}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Scrim.Opacity" Value="0.06" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Scrim.Opacity" Value="0.12" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Height="72" Padding="{StaticResource Space2}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Dashboard -->
        <Button
            x:Name="DashboardTabButton"
            Grid.Column="0"
            AutomationProperties.Name="Dashboard"
            Click="OnTabClicked"
            Style="{StaticResource WdTabButtonStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    x:Name="DashboardIcon"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Glyph="&#xE8A9;" />
                <TextBlock
                    x:Name="DashboardLabel"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Style="{StaticResource WdCaptionTextStyle}"
                    Text="Dashboard" />
                <Border
                    x:Name="DashboardUnderline"
                    Grid.Row="2"
                    Width="28"
                    Height="3"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Background="{x:Bind AccentBrush, Mode=OneWay}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Visibility="Collapsed" />
            </Grid>
        </Button>

        <!-- Media -->
        <Button
            x:Name="MediaTabButton"
            Grid.Column="1"
            AutomationProperties.Name="Media"
            Click="OnTabClicked"
            Style="{StaticResource WdTabButtonStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    x:Name="MediaIcon"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Glyph="&#xE8D6;" />
                <TextBlock
                    x:Name="MediaLabel"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Style="{StaticResource WdCaptionTextStyle}"
                    Text="Media" />
                <Border
                    x:Name="MediaUnderline"
                    Grid.Row="2"
                    Width="28"
                    Height="3"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Background="{x:Bind AccentBrush, Mode=OneWay}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Visibility="Collapsed" />
            </Grid>
        </Button>

        <!-- Performance -->
        <Button
            x:Name="PerformanceTabButton"
            Grid.Column="2"
            AutomationProperties.Name="Performance"
            Click="OnTabClicked"
            Style="{StaticResource WdTabButtonStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    x:Name="PerformanceIcon"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Glyph="&#xE9D9;" />
                <TextBlock
                    x:Name="PerformanceLabel"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Style="{StaticResource WdCaptionTextStyle}"
                    Text="Performance" />
                <Border
                    x:Name="PerformanceUnderline"
                    Grid.Row="2"
                    Width="28"
                    Height="3"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Background="{x:Bind AccentBrush, Mode=OneWay}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Visibility="Collapsed" />
            </Grid>
        </Button>

        <!-- Weather -->
        <Button
            x:Name="WeatherTabButton"
            Grid.Column="3"
            AutomationProperties.Name="Weather"
            Click="OnTabClicked"
            Style="{StaticResource WdTabButtonStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <FontIcon
                    x:Name="WeatherIcon"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Glyph="&#xE753;" />
                <TextBlock
                    x:Name="WeatherLabel"
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource WdOnSurfaceMutedBrush}"
                    Style="{StaticResource WdCaptionTextStyle}"
                    Text="Weather" />
                <Border
                    x:Name="WeatherUnderline"
                    Grid.Row="2"
                    Width="28"
                    Height="3"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Background="{x:Bind AccentBrush, Mode=OneWay}"
                    CornerRadius="{StaticResource RadiusPill}"
                    Visibility="Collapsed" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
