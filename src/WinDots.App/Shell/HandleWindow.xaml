<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDots.App.Shell.HandleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The 200x12 grid is the hit target and the hover surface; the visible pill sits centred inside it. -->
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <Border
            x:Name="Bar"
            Width="160"
            Height="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="3"
            Background="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
