<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDots.App.Shell.HandleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The window IS the capsule: a slim rounded bar sized to the pill. Content extends to the top edge (no reserved
         title-bar band); a zero-height title-bar region (set in code) leaves no caption, so all pointer input reaches
         the Border. DWM rounds the window corners (anti-aliased). The Border carries the animated fill colour, which
         brightens to the accent on hover and breathes gently at rest. -->
    <Grid x:Name="Root" Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <!-- Zero-height draggable region: designating it means the rest of the window is content, not caption. -->
        <Border x:Name="TitleBarRegion" Height="0" VerticalAlignment="Top" />
        <Border x:Name="Bar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <SolidColorBrush x:Name="FillBrush" />
            </Border.Background>
        </Border>
    </Grid>
</Window>
