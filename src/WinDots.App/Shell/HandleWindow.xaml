<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinDots.App.Shell.HandleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The window itself is the pill: it is sized to the visual (160x6, 200x8 on hover) and clipped to a stadium
         region in code (SetWindowRgn) so its corners are transparent. The Border fills the window and only carries the
         pill fill colour, which brightens on hover. -->
    <Grid PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
        <Border
            x:Name="Bar"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="3"
            Background="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
